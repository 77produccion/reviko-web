---
/* Oferta "Negocios fundadores": valor agregado sin bajar el precio. */
import Eyebrow from "../components/Eyebrow.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import type { Locale } from "../i18n/config";
import { growth } from "../i18n/growth";

export interface Props {
  locale?: Locale;
}
const { locale = "es" } = Astro.props;
const t = growth[locale].founders;

const icons: Record<string, string> = {
  setup: "M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z",
  kit: "M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2v2h-2zM18 18h2v2h-2zM14 18h2v2h-2zM18 14h2v2h-2z",
  content: "M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Zm0 11 5-5 4 4 3-3 6 6M15.5 8.5h.01",
  chat: "M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.8-.9L3 20l1.1-4.6A8.4 8.4 0 1 1 21 11.5Z",
};
---

<section class="founders" id="fundadores" aria-labelledby="founders-title">
  <div class="container founders-card">
    <div class="founders-copy">
      <Eyebrow>{t.eyebrow}</Eyebrow>
      <h2 id="founders-title" class="display-sm" data-lines>
        {t.title.map((line, i) => (
          <span class="line"><span class={i === t.title.length - 1 ? "hl" : undefined}>{line}</span></span>
        ))}
      </h2>
      <p class="founders-sub" data-reveal>{t.sub}</p>

      <ul class="perks" data-stagger>
        {t.perks.map((perk) => (
          <li>
            <span class="perk-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[perk.icon]} />
              </svg>
            </span>
            <div>
              <h3>{perk.title}</h3>
              <p>{perk.text}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="founders-cta" data-reveal>
        <WhatsAppButton message={t.whatsappMsg} label={t.cta} variant="primary" />
      </div>
    </div>

    <div class="founders-visual" aria-hidden="true" data-reveal="scale">
      <div class="glow"></div>
      <!-- Display de mostrador dibujado en CSS -->
      <div class="stand">
        <div class="stand-face">
          <div class="stand-top">
            <img src="/reviko-la-vuelta.svg" alt="" width="28" height="28" />
            <span>{t.standShop}</span>
          </div>
          <p class="stand-title">{t.standTitle}</p>
          <svg class="stand-qr" viewBox="0 0 80 80" width="120" height="120">
            <rect x="4" y="4" width="26" height="26" fill="none" stroke="#0B2A1D" stroke-width="5"/>
            <rect x="50" y="4" width="26" height="26" fill="none" stroke="#0B2A1D" stroke-width="5"/>
            <rect x="4" y="50" width="26" height="26" fill="none" stroke="#0B2A1D" stroke-width="5"/>
            <rect x="12" y="12" width="10" height="10" fill="#0B2A1D"/><rect x="58" y="12" width="10" height="10" fill="#0B2A1D"/>
            <rect x="12" y="58" width="10" height="10" fill="#0B2A1D"/><rect x="42" y="42" width="8" height="8" fill="#0B2A1D"/>
            <rect x="54" y="50" width="6" height="6" fill="#0B2A1D"/><rect x="62" y="62" width="10" height="10" fill="#0B2A1D"/>
            <rect x="42" y="60" width="6" height="12" fill="#0B2A1D"/><rect x="38" y="8" width="6" height="6" fill="#0B2A1D"/>
            <rect x="40" y="22" width="6" height="10" fill="#0B2A1D"/><rect x="8" y="38" width="10" height="6" fill="#0B2A1D"/>
          </svg>
          <p class="stand-sub">{t.standSub}</p>
          <div class="stand-nfc">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 8.5a6 6 0 0 1 0 7M9.5 6a10 10 0 0 1 0 12M13 3.5a14 14 0 0 1 0 17"/></svg>
            {t.standNfc}
          </div>
        </div>
        <div class="stand-base"></div>
      </div>
      <div class="sticker">NFC</div>
      <div class="counter">
        <strong>50</strong>
        <span>{t.counterLabel}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .founders { padding: var(--section-space) 0; background: var(--reviko-cream); }
  .founders-card {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    background: var(--reviko-card);
    border: 1px solid rgb(11 42 29 / 0.1);
    border-radius: 32px;
    padding: clamp(1.6rem, 4vw, 3.5rem);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .founders-copy .display-sm { margin-top: 1rem; color: var(--reviko-green); }
  .hl { position: relative; }
  .hl::after {
    content: ""; position: absolute; left: 0; right: 4%; bottom: 8%;
    height: 0.16em; background: var(--reviko-lime); z-index: -1; border-radius: 4px;
  }
  .founders-copy h2 .line > span { position: relative; z-index: 0; }
  .founders-sub { margin-top: 1.1rem; max-width: 32rem; color: var(--reviko-sage); font-size: 1.05rem; }

  .perks {
    list-style: none; padding: 0; margin: 1.8rem 0 0;
    display: grid; gap: 1.1rem;
  }
  .perks li { display: grid; grid-template-columns: 46px minmax(0, 1fr); gap: 0.9rem; align-items: start; }
  .perk-icon {
    width: 46px; height: 46px; border-radius: 14px;
    display: grid; place-items: center;
    background: var(--reviko-green); color: var(--reviko-lime);
  }
  .perks h3 { font-size: 1.08rem; letter-spacing: -0.02em; line-height: 1.2; color: var(--reviko-green); }
  .perks p { margin-top: 0.2rem; font-size: 0.93rem; color: var(--reviko-sage); line-height: 1.5; }
  .founders-cta { margin-top: 2rem; }

  .founders-visual {
    position: relative;
    min-height: 460px;
    display: grid;
    place-items: center;
    border-radius: 24px;
    background:
      radial-gradient(circle at 70% 20%, rgb(199 249 121 / 0.35), transparent 55%),
      var(--reviko-green);
    overflow: hidden;
  }
  .glow {
    position: absolute; width: 60%; aspect-ratio: 1; border-radius: 50%;
    background: rgb(199 249 121 / 0.18); filter: blur(60px); bottom: -20%; left: -10%;
  }
  .stand { position: relative; transform: rotate(-4deg); }
  .stand-face {
    width: 230px;
    background: var(--reviko-cream);
    border-radius: 18px 18px 6px 6px;
    padding: 1.1rem 1.1rem 1.2rem;
    display: grid; justify-items: center; gap: 0.6rem;
    text-align: center;
    box-shadow:
      inset 0 0 0 6px rgb(255 255 255 / 0.6),
      0 30px 60px -20px rgb(0 0 0 / 0.6);
  }
  .stand-top {
    width: 100%; display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.78rem; font-weight: 800; color: var(--reviko-green);
    padding-bottom: 0.6rem; border-bottom: 1px solid rgb(11 42 29 / 0.12);
  }
  .stand-title { font-size: 1.3rem; font-weight: 800; letter-spacing: -0.03em; color: var(--reviko-green); }
  .stand-qr { background: #fff; border-radius: 10px; padding: 8px; }
  .stand-sub { font-size: 0.78rem; color: var(--reviko-sage); }
  .stand-nfc {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--reviko-lime); color: var(--reviko-green);
    border-radius: 999px; padding: 0.4rem 0.8rem; font-size: 0.75rem; font-weight: 800;
  }
  .stand-base {
    width: 260px; height: 18px; margin: 0 auto;
    margin-left: -15px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.15));
    border-radius: 4px 4px 12px 12px;
  }
  .sticker {
    position: absolute; right: 12%; top: 14%;
    width: 78px; height: 78px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--reviko-ink); color: var(--reviko-lime);
    font-weight: 800; letter-spacing: 0.12em; font-size: 0.85rem;
    border: 3px solid var(--reviko-lime);
    transform: rotate(10deg);
    box-shadow: 0 14px 30px -10px rgb(0 0 0 / 0.6);
  }
  .counter {
    position: absolute; left: 8%; bottom: 10%;
    display: grid; line-height: 1;
    background: var(--reviko-cream); color: var(--reviko-green);
    border-radius: 16px; padding: 0.8rem 1rem;
    box-shadow: var(--shadow-soft);
  }
  .counter strong { font-size: 2rem; letter-spacing: -0.05em; }
  .counter span { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--reviko-sage); margin-top: 0.2rem; }

  @media (min-width: 980px) {
    .founders-card { grid-template-columns: 1.05fr 0.95fr; }
    .founders-visual { min-height: 560px; height: 100%; }
  }
  @media (max-width: 639px) {
    .founders-visual { min-height: 470px; padding: 2.5rem 0 5.5rem; }
    .stand { transform: rotate(-4deg) scale(0.88); }
    .sticker { width: 60px; height: 60px; right: 6%; top: 6%; font-size: 0.72rem; }
    .counter { left: 50%; bottom: 1.1rem; transform: translateX(-50%); grid-auto-flow: column; align-items: center; gap: 0.6rem; }
    .counter span { margin-top: 0; }
    .founders-cta :global(.btn) { width: 100%; justify-content: center; }
  }
</style>
