---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { whatsappLink } from "../i18n/config";

export interface Props {
  message: string;
  label: string;
  variant?: "ghost" | "primary" | "lime" | "whatsapp";
  dark?: boolean;
  class?: string;
}
const { message, label, variant = "ghost", dark = false, class: className } = Astro.props;
---

<a
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener"
  class:list={["btn", `btn-${variant}`, "btn-wa", dark && "on-dark", className]}
  data-track="whatsapp"
>
  <WhatsAppIcon size={19} />
  <span>{label}</span>
</a>
