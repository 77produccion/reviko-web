---
/* Botón flotante de WhatsApp. Aparece después del hero. */
import WhatsAppIcon from "./WhatsAppIcon.astro";
import type { Locale } from "../i18n/config";
import { whatsappLink } from "../i18n/config";
import { growth } from "../i18n/growth";

export interface Props {
  locale?: Locale;
}
const { locale = "es" } = Astro.props;
const t = growth[locale].whatsappFloat;
---

<a
  class="wa-float"
  href={whatsappLink(t.message)}
  target="_blank"
  rel="noopener"
  aria-label={t.label}
  data-wa-float
  data-track="whatsapp"
>
  <span class="wa-bubble">{t.bubble}</span>
  <span class="wa-dot"><WhatsAppIcon size={28} /></span>
</a>

<script>
  function initWaFloat() {
    const el = document.querySelector<HTMLElement>("[data-wa-float]");
    if (!el || el.dataset.ready) return;
    el.dataset.ready = "1";
    const onScroll = () => {
      el.classList.toggle("is-visible", window.scrollY > window.innerHeight * 0.6);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
  document.addEventListener("astro:page-load", initWaFloat);
  initWaFloat();
</script>

<style>
  .wa-float {
    position: fixed;
    right: clamp(1rem, 2.5vw, 1.75rem);
    bottom: clamp(1rem, 2.5vw, 1.75rem);
    z-index: 60;
    display: flex; align-items: center; gap: 0.6rem;
    opacity: 0; transform: translateY(16px) scale(0.9);
    pointer-events: none;
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }
  .wa-float.is-visible { opacity: 1; transform: none; pointer-events: auto; }
  .wa-dot {
    position: relative;
    width: 60px; height: 60px; border-radius: 50%;
    display: grid; place-items: center;
    background: #25d366; color: #fff;
    box-shadow: 0 14px 30px -10px rgb(6 43 23 / 0.55);
    transition: transform 0.25s var(--ease-out);
  }
  .wa-dot::after {
    content: ""; position: absolute; inset: 0; border-radius: 50%;
    border: 2px solid #25d366;
    animation: wa-ping 2.4s var(--ease-out) infinite;
  }
  .wa-float:hover .wa-dot { transform: scale(1.06); }
  .wa-bubble {
    background: var(--reviko-green); color: var(--reviko-cream);
    font-weight: 800; font-size: 0.86rem;
    padding: 0.55rem 0.9rem; border-radius: 999px;
    box-shadow: var(--shadow-soft);
  }
  @keyframes wa-ping {
    0% { transform: scale(1); opacity: 0.8; }
    80%, 100% { transform: scale(1.45); opacity: 0; }
  }
  @media (max-width: 639px) {
    .wa-bubble { display: none; }
    .wa-dot { width: 54px; height: 54px; }
  }
</style>
